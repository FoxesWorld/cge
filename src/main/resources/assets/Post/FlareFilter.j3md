MaterialDef FlareFilter {

    MaterialParameters {
        Float FlareIntensity
        Float FlareThreshold
        Color FlareColor
        Texture2D Texture
    }

    Technique {
        VertexShader   GLSL150: Common/MatDefs/Post/Post.vert
        FragmentShader GLSL150: assets/Post/FlareFilter.frag

        WorldParameters {
        }

        RenderState {
            Blend Additive
        }
    }
}