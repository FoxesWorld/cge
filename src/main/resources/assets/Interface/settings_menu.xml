<?xml version="1.0" encoding="UTF-8"?>
<menu>
    <screen>


        <panel id="settings" anchor="CENTER" dpiScale="1.0" width="95%" bgColor="#000000" cornerRadius="20" bgAlpha="0.5">
            <components>
                <button iconPath="assets/Interface/ui/icons/back.png" iconSize="40" action="org.foxesworld.cge.tmp.menu.actions.GoBackToMainMenuAction" text="BACK" />
                <tabs spacing="0" orientation="VERTICAL">

                    <tab iconPath="assets/Interface/ui/icons/graphic-card.png" title="GRAPHICS">
                        <checkbox text="V-Sync"        bind="graphics.vsync"/>
                        <checkbox text="Shadows"       bind="graphics.shadows"/>
                        <checkbox text="Bloom Effect"  bind="graphics.bloom"/>
                        <checkbox text="SSAO Filter"   bind="graphics.ssao"/>
                    </tab>

                    <tab iconPath="assets/Interface/ui/icons/sound.png" title="AUDIO">
                        <slider text="MASTER VOLUME"  bind="audio.master"/>
                        <slider text="MUSIC"          bind="audio.music" fillColor="#cb2020"/>
                    </tab>

                    <tab iconPath="assets/Interface/ui/icons/process.png" title="CONTROLS">
                        <slider text="MOUSE SENSITIVITY" bind="controls.sensitivity" />
                        <slider text="SMOOTHING"         bind="controls.smoothing"   />
                        <KeyBindings>
                            <KeyBind id="forward" action="Forward" defaultKey="W"     />
                            <KeyBind id="back"    action="Back"    defaultKey="S"     />
                            <KeyBind id="left"    action="Left"    defaultKey="A"     />
                            <KeyBind id="right"   action="Right"   defaultKey="D"     />
                            <KeyBind id="jump"    action="Jump"    defaultKey="space" />
                        </KeyBindings>

                    </tab>
                </tabs>
                <button id="quit" action="org.foxesworld.cge.tmp.menu.actions.SaveSettingsAction" iconPath="assets/Interface/ui/icons/apply.png" iconSize="40" height="95" text="Применить" />
            </components>
        </panel>
    </screen>
</menu>