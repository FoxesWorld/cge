<menu>
    <!--
      Логотип. ID 'logo' используется в коде для специального позиционирования.
      Размеры и позиция X/Y из XML будут проигнорированы в пользу констант в коде.
    -->
    <element type="image" id="logo" path="Textures/logo.png" width="400" height="150" x="50" y="700" />

    <!--
      Кнопки. Их порядок в XML определяет их порядок на экране.
      Позиции и размеры будут установлены программно.
    -->
    <element type="button" id="btnStart" text="menu.start" />
    <element type="button" id="btnOptions" text="menu.options" />
    <element type="button" id="btnMods" text="menu.mods" /> <!-- Легко добавить новые кнопки -->
    <element type="button" id="btnExit" text="menu.exit" />

</menu>