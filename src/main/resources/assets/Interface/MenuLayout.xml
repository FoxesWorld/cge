<menu>
    <!-- Фоновое изображение на весь экран -->
    <element id="background" type="image"
             x="0" y="0"
             width="1920" height="1080"
             src="assets/Textures/menuBg.png"
             style="cover" />


    <!-- Нижняя панель кнопок -->
    <element id="buttonPanel" type="panel"
             x="1400" y="920"
             width="480" height="120"
             color="0.10 0.14 0.18 0.85"
             border-radius="16"
             shadow="true">

        <element id="btnExit" type="button"
                 x="20" y="20"
                 width="120" height="80"
                 text="Exit"
                 font-size="24"
                 color="1 1 1 1"
                 background-color="0.8 0.2 0.2 0.95"
                 hover-color="1 0.3 0.3 0.95"
                 border-radius="12"/>

        <element id="btnOptions" type="button"
                 x="160" y="20"
                 width="140" height="80"
                 text="Options"
                 font-size="24"
                 color="1 1 1 1"
                 background-color="0.2 0.4 0.8 0.95"
                 hover-color="0.3 0.5 1 0.95"
                 border-radius="12"/>

        <element id="btnStart" type="button"
                 x="320" y="20"
                 width="140" height="80"
                 text="Play"
                 font-size="24"
                 color="1 1 1 1"
                 background-color="0.2 0.8 0.3 0.95"
                 hover-color="0.3 1 0.4 0.95"
                 border-radius="12"/>
    </element>
</menu>
