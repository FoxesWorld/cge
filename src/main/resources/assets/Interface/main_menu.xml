<?xml version="1.0" encoding="UTF-8"?>

<menu>
    <scene
            modelPath="assets/meshes/plm.obj"
            skyboxPath="assets/Textures/sky.dds"
            modelScale="0.5"
            modelOffsetY="-1.0"
            cameraDistance="4.5"
            cameraHeight="1.5"
            lookAtY="2.0" />

    <screen>
        <panel id="logoPanel" anchor="TOP_LEFT" y="-25%" x="4%" width="250"  dpiScale="1.0" spacing="5" bgColor="#000000" bgAlpha="0.3">
            <components>
                <image scaleMode="cover" path="assets/Interface/ui/engine.png" />
            </components>
        </panel>

            <panel id="main_panel" anchor="CENTER" dpiScale="1.0" spacing="5" bgColor="#000000" bgAlpha="0.95">
            <components>
                <button id="play" action="org.foxesworld.cge.tmp.menu.actions.StartGameAction" iconPath="assets/Interface/ui/icons/play.png"  iconSize="40" height="95" text="Играть" />
                <button id="settings" action="org.foxesworld.cge.tmp.menu.actions.OpenSettingsAction" iconPath="assets/Interface/ui/icons/settings.png" iconSize="40" height="95" text="Настройки" />
                <button id="settings" action="org.foxesworld.cge.tmp.menu.actions.OpenAboutAction" iconPath="assets/Interface/ui/icons/info.png" iconSize="40" height="95" text="Что это" />
                <button id="quit" action="org.foxesworld.cge.tmp.menu.actions.QuitGameAction" iconPath="assets/Interface/ui/icons/quit.png" iconSize="40" height="95" text="Выход" />
            </components>
        </panel>


        <panel id="infoPanel" anchor="BOTTOM_CENTER" dpiScale="1.0" height="12%" width="100%" bgColor="#1d84de" cornerRadius="0" bgAlpha="0.5">
            <components>
                <text anchor="TOP_LEFT" id="title" text="Calista Game Engine" color="#1baade" fontSize="20vh" />
                <text id="version" fontPath="assets/Interface/fonts/Intro-Black.ttf" text="ALPHA PreBuild 0.0.5-r" color="#00bbff" fontSize="15vw" />
                <text id="type" fontPath="assets/Interface/fonts/FSElliotPro.ttf" text="EXPERIMENTAL" color="#ff00a9" fontSize="14vw" />
            </components>
        </panel>
    </screen>
</menu>