<?xml version="1.0" encoding="UTF-8"?>
<!--
    Эта разметка использует структурированный формат со свойствами в виде дочерних тегов.

    КЛЮЧЕВЫЕ ПРИНЦИПЫ:
    1. 'id' элемента остается атрибутом для быстрой идентификации.
    2. Все остальные параметры (margin, color, width и т.д.) выносятся в теги <property name="..." value="..."/>.
    3. Этот подход позволяет в будущем использовать сложные значения свойств (например, вложенные XML).
-->
<Panel id="rootPanel">
    <property name="margin" value="0,40"/>
    <property name="padding" value="20"/>
    <property name="bgColor" value="0,0,0,0.5"/>
    <property name="width" value="auto"/>
    <property name="height" value="auto"/>
    <property name="align" value="bottom-left"/>
    <property name="layout" value="horizontal"/>
    <property name="spacing" value="0"/>

    <Image id="logo">
        <property name="imagePath" value="assets/Textures/image.png"/>
        <property name="width" value="162"/>
        <property name="height" value="128"/>
        <property name="color" value="1,1,1,1"/>
    </Image>

    <!--
    <Text id="test">
        <property name="fontPath" value="assets/Interface/fonts/Aharoni.fnt"/>
        <property name="margin" value="0,0,0,0"/>
        <property name="align" value="left"/>
        <property name="color" value="0.81, 0.73, 0.31, 1.0"/>
    </Text>
    <Button id="resr2">
        <property name="text" value="left"/>
        <property name="padding" value="5"/>
    </Button>
    -->

    <Panel id="barPanel">
        <property name="margin" value="5"/>
        <property name="padding" value="5"/>
        <property name="bgColor" value="0,0,0,0.0"/>
        <property name="width" value="auto"/>
        <property name="height" value="auto"/>
        <property name="align" value="top-right"/>
        <property name="layout" value="horizontal"/>
        <property name="spacing" value="5"/>


        <Progress id="speed">
            <property name="width" value="150"/>
            <property name="height" value="8"/>
            <property name="borderColor" value="0,0,0,0.8"/>
            <property name="backgroundColor" value="0.23, 0.38, 0.24, 0.1"/>
            <property name="fillColor" value="0.34, 0.52, 0.31, 1.0"/>
            <property name="borderThickness" value="0.1"/>
        </Progress>

        <Progress id="armor">
            <property name="width" value="50"/>
            <property name="height" value="8"/>
            <property name="borderColor" value="0,0,0,0.6"/>
            <property name="backgroundColor" value="0.22, 0.39, 0.47, 0.1"/>
            <property name="fillColor" value="0.23, 0.58, 0.66, 1.0"/>
            <property name="borderThickness" value="0.1"/>
        </Progress>

        <Progress id="ability">
            <property name="width" value="45"/>
            <property name="height" value="8"/>
            <property name="borderColor" value="0,0,0,0.6"/>
            <property name="backgroundColor" value="0.73, 0.60, 0.25, 0.1"/>
            <property name="fillColor" value="0.81, 0.73, 0.31, 1.0"/>
            <property name="borderThickness" value="0.1"/>
        </Progress>
    </Panel>
</Panel>