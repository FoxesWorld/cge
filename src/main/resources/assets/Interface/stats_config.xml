<?xml version="1.0" encoding="UTF-8"?>
<!--
    ИЗМЕНЕНИЯ:
    1. Удален внешний тег <UI>. Корнем документа теперь является сама панель.
    2. Удален тег <Font>. Глобальные шрифты лучше настраивать в теме или коде, а не в разметке.
    3. Теги <Element type="..."> заменены на прямые теги: <Progress>, <Text>.
    4. Путь к шрифту исправлен (убран префикс 'assets/').
    5. Значения цвета исправлены (переведены из диапазона 0-255 в диапазон 0.0-1.0).
-->
<Panel
        id="rootPanel"
        margin="0,40"
        padding="0"
        bgColor="0,0,0,0.3"
        width="auto"
        height="auto"
        align="bottom-left"
        layout="horizontal"
        spacing="0"
>
    <!-- <Image id="logo" imagePath="Textures/nova.png" width="128" height="128" color="1,1,1,1"/> -->

    <Panel id="barPanel"
           margin="5"
           padding="0,25"
           bgColor="0,0,0,0.0"
           width="auto"
           height="auto"
           align="top-right"
           layout="horizontal"
           spacing="5">

        <Text
                id="test"
                fontPath="Interface/fonts/Aharoni.fnt"
                margin="0,-40,0,0"
                align="left"
                color="0.81, 0.73, 0.31, 1.0"
        />

        <Progress
                id="speed"
                width="150"
                height="8"
                borderColor="0,0,0,0.8"
                backgroundColor="0.23, 0.38, 0.24, 0.1"
                fillColor="0.34, 0.52, 0.31, 1.0"
                borderThickness="0.1"
        />



        <Progress
                id="armor"
                width="50"
                height="8"
                borderColor="0,0,0,0.6"
                backgroundColor="0.22, 0.39, 0.47, 0.1"
                fillColor="0.23, 0.58, 0.66, 1.0"
                borderThickness="0.1"
        />

        <Progress
                id="ability"
                width="45"
                height="8"
                borderColor="0,0,0,0.6"
                backgroundColor="0.73, 0.60, 0.25, 0.1"
                fillColor="0.81, 0.73, 0.31, 1.0"
                borderThickness="0.1"
        />
    </Panel>
</Panel>