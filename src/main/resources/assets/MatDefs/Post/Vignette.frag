// Фрагментный шейдер
// Файл: Common/Shaders/Post/Vignette.frag

// 'uniform' переменные - это параметры, которые передаются из .j3md файла.
uniform sampler2D m_Texture; // Текстура с исходной сценой.

uniform vec4 m_Color; // Цвет виньетки.
uniform float m_Start; // Начало градиента.
uniform float m_End;   // Конец градиента.

// 'varying' переменные - это данные, которые приходят из вершинного шейдера.
// В данном случае - текстурные координаты текущего пикселя (от 0.0 до 1.0).
varying vec2 texCoord;

void main() {
    // 1. Получаем оригинальный цвет пикселя из текстуры сцены.
    vec4 originalColor = texture2D(m_Texture, texCoord);

    // 2. Рассчитываем расстояние от текущего пикселя до центра экрана.
    //    Центр экрана имеет координаты (0.5, 0.5).
    float dist = distance(texCoord, vec2(0.5));

    // 3. Вычисляем интенсивность виньетки с помощью smoothstep.
    //    smoothstep создает плавный переход между двумя значениями.
    //    - Если dist < m_Start, результат равен 0.0 (нет затемнения).
    //    - Если dist > m_End, результат равен 1.0 (полное затемнение).
    //    - Между m_Start и m_End будет плавный градиент.
    //    Мы инвертируем результат (1.0 - ...), чтобы в центре было 1.0 (полный цвет),
    //    а по краям 0.0 (цвет виньетки).
    float vignette = 1.0 - smoothstep(m_Start, m_End, dist);

    // 4. Смешиваем (mix) цвет виньетки с оригинальным цветом пикселя.
    //    - 'mix(цвет_A, цвет_B, фактор)'
    //    - Если фактор = 0.0, результатом будет цвет_A.
    //    - Если фактор = 1.0, результатом будет цвет_B.
    //    - В нашем случае, чем ближе 'vignette' к 0.0 (ближе к краю),
    //      тем больше будет виден m_Color (цвет виньетки).
    gl_FragColor = mix(m_Color, originalColor, vignette);
}