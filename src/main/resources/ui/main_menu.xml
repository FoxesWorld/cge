<?xml version="1.0" encoding="UTF-8"?>

<menu>
    <scene
            modelPath=""
            skyboxPath="assets/Textures/sky.dds"
            modelScale="0.5"
            modelOffsetY="-1.0"
            cameraDistance="4.5"
            cameraHeight="1.5"
            lookAtY="2.0"
    />

    <screen>
        <panel id="titlePanel" anchor="BOTTOM_CENTER" dpiScale="1.0" height="12%" width="100%" bgColor="#1d84de" cornerRadius="0" bgAlpha="0.5">
            <components>
                <text anchor="TOP_LEFT" id="title" text="Calista Game Engine" color="#1baade" fontSize="18vh" />
                <text anchor="CENTER_LEFT" id="version" text="ALPHA PreBuild 0.0.4-r" fontSize="7vw" />
                <text id="type" text="EXPERIMENTAL" color="#c027a9" fontSize="5vw" />
            </components>
        </panel>

        <panel id="main_panel" anchor="CENTER" dpiScale="1.0" spacing="5" bgColor="#000000" bgAlpha="0.5">
            <components>
                <button id="play" action="org.foxesworld.cge.tmp.menu.actions.StartGameAction" iconPath="assets/Interface/Icons/bug.png"  iconSize="40" height="125" text="Играть" />
                <button id="settings" action="org.foxesworld.cge.tmp.menu.actions.OpenSettingsAction" iconPath="assets/Interface/ui/icons/settings.png" iconSize="40" height="95" text="Настройки" />
                <button id="quit" action="org.foxesworld.cge.tmp.menu.actions.QuitGameAction" iconPath="assets/Interface/ui/icons/quit.png" iconSize="40" height="95" text="Выход" />
            </components>
        </panel>
    </screen>
</menu>