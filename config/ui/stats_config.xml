<?xml version="1.0" encoding="UTF-8"?>
<StatsDisplay>
    <!-- Шрифт и размер -->
    <Font path="Interface/Fonts/Default.fnt" size="20"/>

    <!-- Параметры панели -->
    <Panel margin="10" padding="8" bgColor="0,0,0,0.5"/>

    <!-- Элементы, которые будем рисовать -->
    <Item name="Speed"
          color="1,1,1,1"
          format="Speed: %.2f m/s (%.2f km/h)"/>
    <Item name="Position"
          color="1,1,0,1"
          format="Position: (%.2f, %.2f, %.2f)"/>
    <Item name="Jump"
          color="0,1,1,1"
          format="Jump: %s"/>
</StatsDisplay>
